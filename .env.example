# ==============================================================================
# 项目环境配置文件示例 - .env.example
#
# 使用说明：
# 1. 复制此文件并重命名为 .env
# 2. 将所有包含 < > 的占位符替换为实际的配置值
# 3. 此模板文件可安全提交至 Git 仓库，请勿将包含真实密码的 .env 文件提交
# ==============================================================================

# ==============================================================================
# 1. 应用基础配置
# ==============================================================================
# 运行环境标识，如 dev, test, prod
APP_ENV=dev
# 导入服务名称
IMPORT_APP_NAME=Enterprise RAG Import Service
# 查询服务名称
QUERY_APP_NAME=Enterprise RAG Query Service
# 服务监听地址，0.0.0.0 表示允许外部访问
APP_HOST=0.0.0.0
# 导入服务监听端口
IMPORT_APP_PORT=8000
# 查询服务监听端口
QUERY_APP_PORT=8001
# 允许跨域访问的源，多个用逗号分隔，* 表示允许所有
CORS_ORIGINS=*

# ==============================================================================
# 2. 日志系统配置 (Loguru)
# ==============================================================================
# 是否在控制台打印日志 (True/False)
LOG_CONSOLE_ENABLE=True
# 控制台日志级别 (DEBUG/INFO/WARNING/ERROR)
# 推荐：开发环境 DEBUG，生产环境 INFO
LOG_CONSOLE_LEVEL=DEBUG
# 是否将日志写入文件 (True/False)
LOG_FILE_ENABLE=True
# 文件日志级别 (DEBUG/INFO/WARNING/ERROR)
LOG_FILE_LEVEL=INFO
# 日志文件保留时长 (自动删除过期日志，避免磁盘占满)
# 格式如 "30 days", "1 week", "6 months"
LOG_FILE_RETENTION=30 days

# ==============================================================================
# 3. LLM / VL 大语言模型配置
# 注意：
# - OPENAI_API_KEY 当前同时被普通 LLM 与 DashScope MCP 配置复用
# - LLM_DEFAULT_TEMPERATURE 必须为浮点数
# ==============================================================================
# API 基础请求地址
OPENAI_BASE_URL=https://<your-llm-endpoint>/v1
# 模型鉴权密钥
OPENAI_API_KEY=sk-<your-api-key-here>
# 默认使用的文本大模型名称
LLM_DEFAULT_MODEL=<your-llm-model-name>
# 生成内容的随机性参数，范围 0.0 至 1.0
LLM_DEFAULT_TEMPERATURE=0.1
# 视觉大模型名称
VL_MODEL=<your-vl-model-name>

# ==============================================================================
# 4. Embedding 向量模型配置
# ==============================================================================
# 模型在本地磁盘的路径
BGE_M3_PATH=./models/<your-embedding-model-path>
# 模型 HuggingFace 标识符或名称
BGE_M3=<your-embedding-model-name>
# 运行设备 (cpu 或 cuda)
BGE_DEVICE=cpu
# 是否启用半精度浮点数 FP16 加速 (True/False)
BGE_FP16=False

# ==============================================================================
# 5. Reranker 重排模型配置
# ==============================================================================
# 重排模型的路径或标识符
BGE_RERANKER_LARGE=./models/<your-reranker-model-path>
# 运行设备 (cpu 或 cuda)
BGE_RERANKER_DEVICE=cpu
# 是否启用半精度浮点数 FP16 加速 (True/False)
BGE_RERANKER_FP16=False

# ==============================================================================
# 6. Milvus 向量数据库配置
# ==============================================================================
# 数据库连接地址
MILVUS_URL=http://<your-milvus-host>:19530
# 存放文档切块的集合名称
CHUNKS_COLLECTION=kb_chunks
# 存放实体名称的集合名称
ENTITY_NAME_COLLECTION=kb_entities
# 存放物品名称的集合名称
ITEM_NAME_COLLECTION=kb_item_names

# ==============================================================================
# 7. Mongo 文档数据库配置
# ==============================================================================
# 数据库连接地址
MONGO_URL=mongodb://<your-mongo-host>:27017
# 数据库名称
MONGO_DB_NAME=enterprise_rag

# ==============================================================================
# 8. MinIO 对象存储配置
# 注意：
# - endpoint 不要带 http 或 https 协议头，由代码内部配合 MINIO_SECURE 参数使用
# - MINIO_IMG_DIR 建议以 / 开头，例如 /kb-images
# ==============================================================================
# 连接地址，格式为 host:port
MINIO_ENDPOINT=<your-minio-host>:9000
# 访问鉴权 Access Key
MINIO_ACCESS_KEY=<your-minio-access-key>
# 访问鉴权 Secret Key
MINIO_SECRET_KEY=<your-minio-secret-key>
# 存储桶名称
MINIO_BUCKET_NAME=enterprise-rag
# 存储图片的目录前缀
MINIO_IMG_DIR=/kb-images
# 是否启用安全传输协议 HTTPS (True/False)
MINIO_SECURE=False

# ==============================================================================
# 9. MinerU 文档解析服务配置
# ==============================================================================
# 服务基础请求地址
MINERU_BASE_URL=https://<your-mineru-endpoint>
# 鉴权 Token
MINERU_API_TOKEN=<your-mineru-api-token>

# ==============================================================================
# 10. DashScope MCP / 联网检索配置
# 注意：MCP_DASHSCOPE_BASE_URL 当前代码可能未实际使用，但建议保留以备后续扩展
# ==============================================================================
# MCP 服务基础地址
MCP_DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/api/v1/mcps/WebSearch/mcp
