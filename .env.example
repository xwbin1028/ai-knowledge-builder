# ==============================================================================
# 第一次测试内容
# ==============================================================================
APP_ENV='ENV'


# ==============================================================================
# 日志系统配置 (Loguru)
# ==============================================================================

# 是否在控制台打印日志 (True/False)
LOG_CONSOLE_ENABLE=True

# 控制台日志级别 (DEBUG/INFO/WARNING/ERROR)
# 推荐：开发环境 DEBUG，生产环境 INFO 或 WARNING
LOG_CONSOLE_LEVEL=DEBUG

# 是否将日志写入文件 (True/False)
LOG_FILE_ENABLE=True

# 文件日志级别 (DEBUG/INFO/WARNING/ERROR)
LOG_FILE_LEVEL=INFO

# 日志文件保留时长 (自动删除过期日志，避免磁盘占满)
# (Loguru 格式，如 "30 days", "1 week", "6 months")
LOG_FILE_RETENTION=30 days
